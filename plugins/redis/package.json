{
  "name": "@node-fetch-cache/redis",
  "version": "1.0.0",
  "description": "Redis plugin for node-fetch-cache",
  "type": "module",
  "exports": {
    "import": "./dist/redis_cache.js",
    "require": "./dist/redis_cache.cjs"
  },
  "types": "./dist/redis_cache.d.ts",
  "scripts": {
    "test": "cross-env NODE_OPTIONS=\"--import tsx\" mocha --spec test_redis_cache.ts --timeout 10000 --exit",
    "test:debug": "cross-env NODE_OPTIONS=\"--import tsx\" mocha --inspect --spec test_redis_cache.ts --timeout 10000 --exit",
    "coverage": "c8 --reporter=lcov --reporter=text --reporter=html --exclude=dist --exclude=test_redis_cache.ts npm test",
    "tsc": "tsc",
    "buildcjs": "cross-env rollup ./dist/redis_cache.js --file ./dist/redis_cache.cjs --format cjs",
    "prepublishOnly": "cross-env npm run tsc && npm run buildcjs && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mistval/node-fetch-cache.git"
  },
  "keywords": [
    "node",
    "fetch",
    "node-fetch",
    "cache",
    "redis",
    "plugin"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ioredis": "^5.4.1",
    "node-fetch-cache": "^5.1.1"
  },
  "devDependencies": {
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.4",
    "@types/sinon": "^17.0.3",
    "cross-env": "^7.0.3",
    "dotenv": "^18.0.5",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
