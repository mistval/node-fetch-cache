{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Root Tests",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "test:debug"],
      "console": "integratedTerminal",
      "stopOnEntry": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Redis Tests",
      "cwd": "${workspaceFolder}/plugins/redis",
      "program": "${workspaceFolder}/plugins/redis/node_modules/mocha/bin/mocha.js",
      "args": [
        "--spec", "test_redis_cache.ts",
        "--timeout", "10000",
        "--exit"
      ],
      "runtimeArgs": [
        "--import", "tsx"
      ],
      "console": "integratedTerminal",
      "stopOnEntry": false
    }
  ]
}
